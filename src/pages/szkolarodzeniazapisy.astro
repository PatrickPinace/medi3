---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { site, forms } from "../data/site";
---

<BaseLayout
  title="Zapisy - Szkoła Rodzenia · Medi3"
  description="Zapisz się na zajęcia Szkoły Rodzenia Medi3 w Mielcu - wypełnij formularz zgłoszeniowy online, świadczenie w ramach NFZ."
>
  <PageHero
    eyebrow="Szkoła Rodzenia"
    title="Zapisy na zajęcia stacjonarne szkoły rodzenia"
    subtitle="Tylko dla zapisanych pacjentów poradni Medi3. Wypełnij formularz poniżej, aby się zapisać."
  />

  <section class="container-x py-10 sm:py-16">
    <div class="rounded-[2rem] border border-salmon-100 bg-white dark:border-white/10 dark:bg-white/5 dark:backdrop-blur-sm p-2 sm:p-3 overflow-hidden">
      <iframe
        src={forms.szkolaRodzenia}
        title="Formularz zapisów - Szkoła Rodzenia Medi3"
        class="block w-full rounded-3xl"
        style="height: 1800px;"
        loading="eager"
      ></iframe>
    </div>

    <p class="mt-6 text-center text-sm text-salmon-800/60 dark:text-navy-300">
      Formularz się nie wyświetla?
      <a href={forms.szkolaRodzenia} target="_blank" rel="noopener" class="inline-flex items-center gap-1 font-medium text-salmon-700 dark:text-salmon-300 hover:underline underline-offset-4">
        Otwórz go w nowej karcie
        <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </p>
  </section>

  <section class="container-x pb-16 sm:pb-20">
    <div class="relative overflow-hidden rounded-[2.5rem] cta-gradient px-6 py-12 sm:px-14 sm:py-20 text-white dark:text-white/80">
      <div class="absolute -right-20 -top-20 h-72 w-72 rounded-full bg-white/10 blur-3xl"></div>
      <div class="absolute -left-16 -bottom-24 h-80 w-80 rounded-full bg-white/5 blur-3xl"></div>
      <div class="relative max-w-3xl mx-auto text-center">
        <h2 class="font-serif text-3xl sm:text-5xl tracking-tight leading-tight">Masz pytania o zajęcia?</h2>
        <p class="mt-4 text-white/85 dark:text-white/50 text-base sm:text-lg">Zadzwoń lub napisz - pomożemy dobrać termin i odpowiemy na wszystkie pytania.</p>
        <div class="mt-7 sm:mt-8 flex flex-wrap justify-center gap-3">
          <a href={`tel:${site.phoneTel}`} class="inline-flex items-center justify-center gap-2 rounded-full bg-white text-salmon-700 px-6 py-3 text-sm font-medium hover:bg-cream-50 transition w-full sm:w-auto dark:bg-white/15 dark:text-white/70 dark:hover:bg-white/25">
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 4h3l2 5-2.5 1.5a11 11 0 0 0 6 6L15 14l5 2v3a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg>
            {site.phone}
          </a>
          <a href={`mailto:${site.email}`} class="inline-flex items-center justify-center gap-2 rounded-full border border-white/40 px-6 py-3 text-sm font-medium hover:bg-white/10 transition w-full sm:w-auto dark:border-white/20 dark:text-white/60">
            {site.email}
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
