---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { site, zapisyWarsztatyApi } from "../data/site";
import { url } from "../utils/url";
import "../styles/m3-form.css";
---

<BaseLayout
  title="Zapisy na warsztaty · Medi3"
  description="Zapisy na warsztaty i zajęcia Fundacji Medi3 w Mielcu - wybierz termin i zapisz się online. Liczba miejsc w grupie jest ograniczona."
>
  <link slot="head" rel="preconnect" href="https://script.google.com" />
  <link slot="head" rel="preconnect" href="https://script.googleusercontent.com" crossorigin />

  <PageHero
    eyebrow="Warsztaty"
    title="Zapisy na warsztaty"
    subtitle="Płatne warsztaty dla rodziców. Wybierz termin i zapisz się online - liczba miejsc w grupie jest ograniczona."
  />

  <section class="container-x py-10 sm:py-16">
    <div
      id="m3pp"
      class="m3form"
      data-api={zapisyWarsztatyApi}
      data-phone={site.phone}
      data-tel={site.phoneTel}
    >
      <div class="m3-wrap">
        <div class="m3-card" id="pp-card">
          <p class="m3-loading" id="pp-loading">Wczytywanie terminów…</p>

          <div id="pp-choice" hidden>
            <h2 class="m3-sec-title" id="pp-choice-title"></h2>
            <div id="pp-choice-list"></div>
          </div>

          <div id="pp-main" hidden>
            <h2 class="m3-sec-title" id="pp-event-name"></h2>
            <p class="m3-sec-help" id="pp-event-desc"></p>
            <div class="m3-notice" id="pp-notice" hidden>
              <p class="m3-notice-title">Zajęcia już się odbyły</p>
              <p class="m3-notice-text">Nowy termin podamy później. Jeśli interesują Cię te zajęcia, zapisz się na listę oczekujących poniżej.</p>
            </div>
            <p class="m3-price" id="pp-price" hidden></p>
            <h3 class="m3-step" id="pp-terms-title" style="margin-top:0">Terminy</h3>
            <div class="m3-slots" id="pp-slots"></div>
            <p class="m3-sec-help" id="pp-info"></p>

            <form id="pp-f" novalidate>
              <label class="m3-f"><span>Imię i nazwisko</span><input type="text" name="imie" autocomplete="name" required /></label>
              <div class="m3-row">
                <label class="m3-f"><span>E-mail</span><input type="email" name="email" autocomplete="email" required /></label>
                <label class="m3-f"><span>Telefon</span><input type="tel" name="telefon" autocomplete="tel" placeholder="np. 600 123 456" required /></label>
              </div>
              <label class="m3-f"><span>Liczba osób</span>
                <select name="osob" id="pp-osob"></select>
              </label>
              <p class="m3-hint">Wybierz łącznie tyle osób, ile przyjdzie (np. oboje rodzice).</p>
              <p class="m3-total" id="pp-total" hidden></p>
              <label class="m3-f"><span>Uwagi (opcjonalnie)</span><input type="text" name="uwagi" maxlength="500" /></label>

              <input class="m3-hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />

              <label class="m3-opt"><input type="checkbox" name="zgoda" required />
                <span>Zapoznałam/em się z <a href={url("/rodo")} target="_blank" rel="noopener">klauzulą informacyjną RODO</a>.</span></label>

              <button type="submit" class="m3-btn m3-btn-main" id="pp-btn">Zapisz się</button>
              <div id="pp-msg" class="m3-msg" role="status" aria-live="polite"></div>
            </form>
          </div>

          <div id="pp-done" class="m3-done" hidden>
            <div class="m3-tick">✓</div>
            <h2 id="pp-done-title">Zapisaliśmy Cię</h2>
            <p id="pp-done-group"></p>
            <p id="pp-done-total" hidden></p>
            <p id="pp-done-mail"></p>
            <p>W razie pytań zadzwoń: <a href={`tel:${site.phoneTel}`}>{site.phone}</a></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="container-x pb-16 sm:pb-20">
    <div class="relative overflow-hidden rounded-[2.5rem] cta-gradient px-6 py-12 sm:px-14 sm:py-20 text-white dark:text-white/80">
      <div class="absolute -right-20 -top-20 h-72 w-72 rounded-full bg-white/10 blur-3xl"></div>
      <div class="absolute -left-16 -bottom-24 h-80 w-80 rounded-full bg-white/5 blur-3xl"></div>
      <div class="relative max-w-3xl mx-auto text-center">
        <h2 class="font-serif text-3xl sm:text-5xl tracking-tight leading-tight">Masz pytania?</h2>
        <p class="mt-4 text-white/85 dark:text-white/50 text-base sm:text-lg">Zadzwoń lub napisz - pomożemy w zapisie i odpowiemy na wszystkie pytania.</p>
        <div class="mt-7 sm:mt-8 flex flex-wrap justify-center gap-3">
          <a href={`tel:${site.phoneTel}`} class="inline-flex items-center justify-center gap-2 rounded-full bg-white text-salmon-700 px-6 py-3 text-sm font-medium hover:bg-cream-50 transition w-full sm:w-auto dark:bg-white/15 dark:text-white/70 dark:hover:bg-white/25">
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 4h3l2 5-2.5 1.5a11 11 0 0 0 6 6L15 14l5 2v3a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg>
            {site.phone}
          </a>
          <a href={`mailto:${site.email}`} class="inline-flex items-center justify-center gap-2 rounded-full border border-white/40 px-6 py-3 text-sm font-medium hover:bg-white/10 transition w-full sm:w-auto dark:border-white/20 dark:text-white/60">
            {site.email}
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
(function () {
  var root = document.getElementById('m3pp');
  var API = root.dataset.api, PHONE = root.dataset.phone, TEL = 'tel:' + root.dataset.tel;
  var $ = function (id) { return document.getElementById(id); };
  var f = $('pp-f'), btn = $('pp-btn'), msg = $('pp-msg');
  var esc = function (s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); };

  function unavailable() {
    $('pp-loading').innerHTML = 'Nie udało się wczytać terminów. Odśwież stronę albo zadzwoń: <a href="' + TEL + '">' + esc(PHONE) + '</a>.';
  }
  if (!API) { unavailable(); return; }

  var anyFree = false, EVENT = null, PAST = false;
  var W = new URLSearchParams(location.search).get('w') || '';

  function today() {
    var d = new Date(), p = function (n) { return (n < 10 ? '0' : '') + n; };
    return d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate());
  }

  function renderSlots(groups, interest) {
    var html = '', now = today();
    groups.forEach(function (g) {
      var cls = 'm3-slot', info;
      if (!g.open) {
        cls += ' planned';
        info = g.date < now ? 'Zajęcia się odbyły.' : interest ? 'Zapisy na ten termin jeszcze nie ruszyły.' : 'Druga grupa ruszy, jeśli zbierze się komplet chętnych.';
      }
      else if (g.left <= 0) { cls += ' full'; info = '<span class="m3-left">Komplet - brak wolnych miejsc</span>'; }
      else { cls += ' free'; info = '<span class="m3-left">Wolnych miejsc: ' + g.left + ' z ' + g.limit + '</span>'; }
      html += '<div class="' + cls + '"><b>' + esc(g.label) + '</b>'
        + (g.place ? '<span>' + esc(g.place) + '</span>' : '')
        + (g.open ? info : '<span>' + info + '</span>') + '</div>';
    });
    $('pp-slots').innerHTML = html;
  }

  function load() {
    fetch(API + (W ? '?w=' + encodeURIComponent(W) : '')).then(function (r) { return r.json(); }).then(function (data) {
      if (!data || !data.ok) throw new Error('status');
      $('pp-loading').hidden = true;
      if (!data.event) { showChoice(data); return; }
      EVENT = data.event;
      $('pp-event-name').textContent = EVENT.name;
      $('pp-event-desc').textContent = EVENT.description || '';
      $('pp-event-desc').hidden = !EVENT.description;
      var opts = '';
      for (var n = 1; n <= EVENT.maxOsob; n++) opts += '<option value="' + n + '">' + n + (n === 1 ? ' osoba' : n < 5 ? ' osoby' : ' osób') + '</option>';
      $('pp-osob').innerHTML = opts;
      var price = EVENT.price;
      $('pp-price').hidden = !price;
      if (price) $('pp-price').textContent = 'Cena: ' + price.text + '.' + (data.payment ? ' ' + data.payment : '');
      updateTotal();
      var open = data.groups.filter(function (g) { return g.open; });
      anyFree = open.some(function (g) { return g.left > 0; });
      $('pp-main').hidden = false;
      var interest = !open.length;
      PAST = interest && data.groups.length > 0 && data.groups.every(function (g) { return g.date < today(); });
      renderSlots(data.groups, interest);
      $('pp-terms-title').hidden = !data.groups.length;
      $('pp-notice').hidden = !PAST;
      btn.textContent = PAST ? 'Zapisz się na listę oczekujących' : interest ? 'Zapisz się na listę zainteresowanych' : (anyFree ? 'Zapisz się' : 'Zapisz się na listę rezerwową');
      $('pp-info').textContent = PAST
        ? 'Zostaw dane - damy znać jako pierwszym, gdy ogłosimy nowy termin, a miejsca przydzielimy w kolejności zgłoszeń.'
        : interest
        ? 'Terminy zostaną ogłoszone wkrótce. Zostaw dane - damy znać jako pierwszym, gdy otworzymy zapisy, a miejsca przydzielimy w kolejności zgłoszeń.'
        : anyFree
          ? 'Zapiszemy Cię do pierwszej grupy, w której jest wystarczająco dużo miejsc.'
          : 'Wszystkie miejsca są zajęte. Zapisz się na listę rezerwową - damy znać, jeśli zbierze się kolejna grupa albo zwolni się miejsce.';
    }).catch(unavailable);
  }

  function totalFor(n) {
    var p = EVENT && EVENT.price;
    if (!p) return null;
    return Math.floor(n / 2) * (p.pair || 2 * p.single) + (n % 2) * (p.single || p.pair);
  }
  function updateTotal() {
    var t = totalFor(Number($('pp-osob').value));
    $('pp-total').hidden = t === null;
    if (t !== null) $('pp-total').textContent = 'Do zapłaty: ' + t + ' zł';
  }
  $('pp-osob').addEventListener('change', updateTotal);

  function showChoice(data) {
    $('pp-choice').hidden = false;
    if (!data.events.length) {
      $('pp-choice-title').textContent = 'Zapisy są obecnie zamknięte';
      $('pp-choice-list').innerHTML = '<p class="m3-sec-help">Nie prowadzimy teraz zapisów na warsztaty. Zadzwoń: ' + esc(PHONE) + '.</p>';
      return;
    }
    $('pp-choice-title').textContent = W ? 'Zapisy na te warsztaty są zamknięte. Zapisz się na:' : 'Wybierz warsztaty';
    $('pp-choice-list').innerHTML = data.events.map(function (e) {
      return '<button type="button" class="m3-choice" data-w="' + esc(e.id) + '"><b>' + esc(e.name) + '</b></button>';
    }).join('');
    Array.prototype.forEach.call(document.querySelectorAll('#pp-choice-list .m3-choice'), function (b) {
      b.addEventListener('click', function () { location.href = location.pathname + '?w=' + encodeURIComponent(b.dataset.w); });
    });
  }

  function showError(text, field) {
    msg.className = 'm3-msg err'; msg.textContent = text;
    if (field) { field.setAttribute('aria-invalid', 'true'); field.focus(); }
  }
  f.addEventListener('input', function (e) { e.target.removeAttribute('aria-invalid'); });

  f.addEventListener('submit', function (e) {
    e.preventDefault();
    msg.textContent = ''; msg.className = 'm3-msg';
    var name = f.imie.value.trim(), email = f.email.value.trim(), phone = f.telefon.value.trim();
    if (name.length < 3 || name.indexOf(' ') < 0) return showError('Podaj imię i nazwisko.', f.imie);
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) return showError('Wpisz poprawny adres e-mail, np. imie@poczta.pl.', f.email);
    if (phone.replace(/\D/g, '').length < 9) return showError('Numer telefonu powinien mieć co najmniej 9 cyfr.', f.telefon);
    if (!f.zgoda.checked) return showError('Zaznacz zapoznanie się z klauzulą informacyjną.', f.zgoda);

    var data = {
      event: EVENT.id, imie: name, email: email, telefon: phone, osob: Number(f.osob.value), uwagi: f.uwagi.value.trim(),
      zgoda: true, website: f.website.value
    };
    btn.disabled = true; var label = btn.textContent; btn.textContent = 'Zapisuję…';
    fetch(API, { method: 'POST', headers: { 'Content-Type': 'text/plain;charset=utf-8' }, body: JSON.stringify({ action: 'register', data: data }) })
      .then(function (r) { return r.json(); })
      .then(function (res) {
        btn.disabled = false; btn.textContent = label;
        if (!(res && res.ok)) { showError((res && res.error) || 'Wystąpił błąd.'); load(); return; }
        var waitlist = res.status === 'waitlist';
        $('pp-main').hidden = true; $('pp-done').hidden = false;
        $('pp-done-title').textContent = res.interest ? (PAST ? 'Jesteś na liście oczekujących' : 'Jesteś na liście zainteresowanych') : waitlist ? 'Jesteś na liście rezerwowej' : 'Zapisaliśmy Cię na warsztaty';
        $('pp-done-group').textContent = res.interest
          ? (PAST ? 'Damy znać, gdy ogłosimy nowy termin.' : 'Damy znać, gdy ustalimy termin i otworzymy zapisy.')
          : waitlist
            ? 'Wszystkie miejsca są obecnie zajęte. Damy znać, jeśli zbierze się kolejna grupa albo zwolni się miejsce.'
            : (res.group ? res.group.label + (res.group.place ? ', ' + res.group.place : '') : '');
        $('pp-done-total').hidden = res.total == null || !!res.interest;
        if (res.total != null) $('pp-done-total').textContent = 'Do zapłaty: ' + res.total + ' zł';
        $('pp-done-mail').textContent = res.mailSent === false
          ? 'Nie udało się wysłać potwierdzenia e-mailem - zapisz termin.'
          : 'Potwierdzenie wysłaliśmy na adres ' + email + '.';
        root.scrollIntoView({ behavior: 'smooth', block: 'start' });
      })
      .catch(function () {
        btn.disabled = false; btn.textContent = label;
        showError('Nie udało się połączyć z serwerem. Spróbuj ponownie lub zadzwoń: ' + PHONE + '.');
      });
  });

  load();
})();
</script>
