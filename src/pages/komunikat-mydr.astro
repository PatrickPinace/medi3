---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { site } from "../data/site";

const kroki = [
  {
    title: "Zastrzeż numer PESEL",
    description: "Najprościej zrobisz to w aplikacji mObywatel lub w urzędzie gminy. To najważniejszy krok chroniący przed wykorzystaniem danych np. do zaciągnięcia kredytu na Twoje nazwisko.",
  },
  {
    title: "Sprawdź, czy Twoje dane znalazły się w wycieku",
    description: "Rządowa baza „Bezpieczne Dane” (bezpiecznedane.gov.pl) umożliwia weryfikację po zalogowaniu.",
  },
  {
    title: "Zachowaj szczególną ostrożność",
    description: "Wobec nieoczekiwanych SMS-ów, e-maili i telefonów podszywających się pod placówki medyczne, ZUS, banki czy urzędy - proszących o potwierdzenie wizyty, dopłatę do badania, aktualizację danych czy podanie kodu/hasła. Nie klikaj w linki i nie podawaj danych osobom, których tożsamości nie możesz zweryfikować.",
  },
];
---

<BaseLayout
  title="Ważna informacja - wyciek danych z systemu MyDr · Medi3"
  description="Informacja o incydencie bezpieczeństwa u dostawcy systemu MyDr i jego możliwym wpływie na dane pacjentów Medi3. Co warto zrobić, zachowując ostrożność."
>
  <PageHero
    eyebrow="Ważna informacja"
    title="Wyciek danych z systemu MyDr"
    subtitle="Informujemy o incydencie bezpieczeństwa u dostawcy oprogramowania medycznego MyDr i o tym, co warto zrobić, zachowując ostrożność."
  />

  <section class="container-x py-12 sm:py-16">
    <div class="grid lg:grid-cols-3 gap-10">
      <!-- Sidebar -->
      <aside class="lg:col-span-1">
        <div class="sticky top-24 space-y-6">
          <div class="rounded-3xl border border-amber-200 bg-amber-50 dark:border-amber-500/20 dark:bg-amber-500/10 p-6 text-center lg:text-left">
            <p class="text-xs font-semibold uppercase tracking-wider text-amber-800/80 dark:text-amber-200/80">Status</p>
            <p class="mt-3 text-sm text-amber-900 dark:text-amber-100">
              Ustalamy zakres incydentu w kontakcie z dostawcą systemu (MyDr). Informacja będzie aktualizowana.
            </p>
          </div>

          <div class="rounded-3xl cta-gradient p-6 text-center lg:text-left text-white dark:text-navy-100">
            <p class="text-xs font-semibold uppercase tracking-wider text-white/80 dark:text-navy-200/70">Masz pytania?</p>
            <p class="mt-3 text-sm">{site.phone}</p>
            <p class="text-sm">{site.email}</p>
          </div>
        </div>
      </aside>

      <!-- Treść -->
      <article class="lg:col-span-2 prose-medi">
        <p>
          Informujemy, że w sierpniu 2026 r. doszło do incydentu bezpieczeństwa u firmy MyDr, dostawcy
          oprogramowania do prowadzenia elektronicznej dokumentacji medycznej (EDM), z którego korzysta nasza
          placówka. W wyniku cyberataku na systemy MyDr mogło dojść do nieuprawnionego dostępu do danych
          osobowych pacjentów wielu placówek medycznych w Polsce korzystających z tego systemu.
        </p>

        <h2 id="co-wiemy">Co obecnie wiemy</h2>
        <p>
          Na dzień publikacji tej informacji nie mamy jeszcze potwierdzenia, czy i w jakim zakresie dane
          naszych pacjentów zostały objęte tym incydentem. Prowadzimy ustalenia w tej sprawie w kontakcie
          z dostawcą systemu (MyDr) oraz analizujemy sytuację zgodnie z obowiązującymi przepisami o ochronie
          danych osobowych (RODO). O wynikach tych ustaleń będziemy informować na bieżąco - w tym miejscu
          oraz, jeśli zajdzie taka potrzeba, indywidualnie osoby, których dane mogły zostać naruszone.
        </p>

        <h2 id="co-zrobic">Co możesz zrobić już teraz, zachowując ostrożność</h2>
        <div class="not-prose space-y-4 my-6">
          {kroki.map((k, i) => (
            <div class="rounded-2xl border border-salmon-100 bg-white dark:border-white/10 dark:bg-white/5 p-5 flex gap-4">
              <span class="shrink-0 inline-flex h-8 w-8 items-center justify-center rounded-full bg-amber-100 text-amber-800 dark:bg-amber-500/20 dark:text-amber-200 text-sm font-semibold">
                {i + 1}
              </span>
              <div>
                <h3 class="font-serif text-lg mt-0 mb-1 text-salmon-800 dark:text-white/80">{k.title}</h3>
                <p class="text-sm leading-relaxed text-salmon-900/80 dark:text-navy-200 mb-0">{k.description}</p>
              </div>
            </div>
          ))}
        </div>

        <p>
          Będziemy aktualizować tę informację w miarę ustalania dalszych szczegółów sprawy.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>
