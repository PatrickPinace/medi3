---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ServiceCard from "../components/ServiceCard.astro";
import NfzBadge from "../components/NfzBadge.astro";
import { forms, site } from "../data/site";
import { url } from "../utils/url";

const primary = [
  { title: "Położne - ciąża", description: "Opieka położnej podczas ciąży, w tym możliwość prowadzenia ciąży fizjologicznej. Świadczenie w ramach NFZ - bez skierowania.", href: forms.ciaza, cta: "Zarejestruj się", nfz: true, icon: "stork", external: true },
  { title: "Szkoła Rodzenia", description: "Przygotowanie do porodu i pierwszych tygodni z dzieckiem - grupowe i indywidualne zajęcia.", href: forms.ciaza, cta: "Zapisz się", nfz: true, icon: "book", external: true },
  { title: "Wizyty patronażowe", description: "Po porodzie odwiedzamy mamę i dziecko w domu - wsparcie laktacyjne, pielęgnacja, badania.", href: forms.ciaza, cta: "Umów wizytę", nfz: true, icon: "home", external: true },
];

const secondary = [
  { title: "Moje Zdrowie", description: "Badania profilaktyczne - morfologia, mocz, lipidogram i inne.", href: forms.ogolny, nfz: true, icon: "shield", external: true },
  { title: "Profilaktyka raka szyjki", description: "Program wczesnego wykrywania (HPV) - dla kobiet w wieku 25–64 lata.", href: forms.ogolny, nfz: true, icon: "ribbon", external: true },
  { title: "Porada laktacyjna", description: "Pomoc, gdy karmienie piersią nie idzie tak, jak byś chciała.", href: forms.laktacyjna, icon: "drop", external: true },
  { title: "Fizjoterapia", description: "Diagnostyka i terapia - okres okołoporodowy, niemowlęta, dorośli.", href: forms.ogolny, icon: "activity", external: true },
  { title: "Pierwsza Pomoc Noworodka", description: "Szkolenie z pierwszej pomocy dla rodziców i opiekunów - 11.06.2026.", href: forms.pierwszaPomoc, cta: "Rejestracja", icon: "alert", external: true },
  { title: "Neurologopeda", description: "Wczesna diagnoza rozwoju mowy i karmienia - niemowlęta i dzieci.", href: `tel:${site.phoneTel}`, cta: "Zadzwoń", icon: "speech" },
];
---

<BaseLayout
  title="Zapisy · Medi3"
  description="Wszystkie formularze zapisów do poradni Medi3 w jednym miejscu - ciąża, szkoła rodzenia, laktacja, profilaktyka, fizjoterapia, szkolenia."
>
  <PageHero
    eyebrow="Rejestracja"
    title="Zapisz się do Medi3"
    subtitle="Wybierz interesujące Cię świadczenie - przekierujemy do odpowiedniego formularza. W razie pytań zadzwoń."
  />

  <div class="container-x pt-8 sm:pt-10 flex justify-center">
    <a href={forms.ciaza} target="_blank" rel="noopener" class="btn-primary relative w-full sm:w-auto !px-8 !pt-6 !pb-4 !text-base sm:!text-lg">
      <NfzBadge class="absolute top-1 left-1/2 -translate-x-1/2 whitespace-nowrap !py-1 !px-2" />
      <svg viewBox="0 -960 960 960" class="h-16 w-16 shrink-0" fill="currentColor">
        <path d="M422.54-111.92v-173.47h-53.69q-12.36 0-20.6-8.24-8.25-8.25-8.25-20.6v-267.46q0-41.93 23.96-65.89t65.39-23.96q41.42 0 64.26 27.62 22.85 27.61 22.85 62.23 47.77 5.61 75.65 39.38Q620-508.54 620-459.16v144.93q0 12.35-8.25 20.6-8.24 8.24-20.6 8.24H479.23v166.54q0 12.36-8.43 20.6Q462.36-90 450.38-90h-5.92q-9.28 0-15.6-6.32t-6.32-15.6Zm-41.31-642.91q-20.15-20.05-20.15-48.61t20.05-48.71q20.06-20.16 48.62-20.16t48.71 20.06q20.16 20.06 20.16 48.62 0 28.55-20.06 48.71-20.06 20.15-48.62 20.15-28.55 0-48.71-20.06Z"/>
      </svg>
      <span>Jestem w ciąży - zapisz się</span>
      <svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </a>
  </div>

  <!-- SEKCJA 1: 3 duże kafelki -->
  <section id="uslugi" class="container-x py-12 md:py-20">
    <div class="max-w-2xl mx-auto md:mx-0 text-center md:text-left">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-salmon-700/70 dark:text-salmon-300/70">Opieka okołoporodowa</p>
      <h2 class="mt-2 font-serif text-3xl sm:text-5xl tracking-tight leading-[1.15] sm:leading-tight text-salmon-800 dark:text-white/80">
        Od pierwszego trymestru<br/> po pierwsze tygodnie życia
      </h2>
      <p class="mt-4 text-salmon-800/70 dark:text-navy-300">
        Wszystkie świadczenia w ramach NFZ - bez skierowania, bez kolejek.
      </p>
    </div>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {primary.map((s) => <ServiceCard {...s} size="lg" />)}
    </div>
  </section>

  <!-- SEKCJA 2: 6 kafelków -->
  <section class="py-16 md:py-20 transition-colors bg-cream-100 dark:bg-navy-900/40">
    <div class="container-x">
      <div class="max-w-2xl mx-auto md:mx-0 text-center md:text-left">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-salmon-700/70 dark:text-salmon-300/70">Pozostałe usługi</p>
        <h2 class="mt-2 font-serif text-3xl sm:text-5xl tracking-tight leading-[1.15] sm:leading-tight text-salmon-800 dark:text-white/80">Profilaktyka, fizjoterapia, edukacja</h2>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {secondary.map((s) => <ServiceCard {...s} />)}
      </div>
    </div>
  </section>

  <section class="container-x py-10 sm:py-12">
    <p class="text-center text-xs text-salmon-800/40 dark:text-navy-400">
      Świadczenia odpłatne · <a href={url("/dane-do-przelewu")} class="inline-flex items-center gap-1 text-salmon-800/50 dark:text-navy-400 hover:text-salmon-700 dark:hover:text-white transition underline underline-offset-4 decoration-white/20">
        <svg viewBox="0 0 24 24" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>
        dane do przelewu
      </a>
    </p>

    <div class="mt-8 rounded-3xl cta-gradient text-white dark:text-white/80 p-6 sm:p-8 flex flex-col sm:flex-row sm:items-center gap-5 justify-between text-center sm:text-left">
      <div>
        <p class="font-serif text-2xl">Wolisz porozmawiać?</p>
        <p class="text-white/85 dark:text-white/50 text-sm mt-1">Zadzwoń, a pomożemy wybrać odpowiednią formę opieki.</p>
      </div>
      <div class="flex flex-col sm:flex-row gap-3 flex-wrap justify-center">
        <a href={`tel:${site.phoneTel}`} class="inline-flex items-center justify-center gap-2 rounded-full bg-white text-salmon-700 px-5 py-2.5 text-sm font-medium hover:bg-navy-100 transition dark:bg-white/15 dark:text-white/70 dark:hover:bg-white/25">
          ☎ {site.phone}
        </a>
        <a href={`mailto:${site.email}`} class="inline-flex items-center justify-center gap-2 rounded-full border border-white/40 px-5 py-2.5 text-sm font-medium hover:bg-white/10 transition">
          {site.email}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
