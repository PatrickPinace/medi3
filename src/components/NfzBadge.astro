---
import { Image } from "astro:assets";
import nfzLogo from "../assets/nfz-logo.png";

interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---
<span class={`inline-flex items-center rounded-full bg-white/70 border border-white/40 px-3 py-1.5 ${className}`}>
  <Image src={nfzLogo} alt="NFZ" class="h-5 w-auto" />
</span>
